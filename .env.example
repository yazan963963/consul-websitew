# Leave all of these empty to keep running in placeholder mode
# (site works fully with seed data, admin edits are in-memory only).
# Fill them in once you create your accounts — see DEPLOYMENT.md.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
